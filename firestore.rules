rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() { return signedIn() && request.auth.token.admin == true && request.auth.token.email_verified == true; }
    match /packs/{id} { allow read: if true; }
    match /pack_drafts/{id} { allow read: if admin(); }
    match /admin_audit/{id} { allow read: if admin(); }
    match /wallets/{uid} { allow read: if owner(uid) || admin(); }
    match /fulfillments/{id} { allow read: if admin() || (signedIn() && resource.data.uid == request.auth.uid); }
    match /users/{uid} {
      allow read: if owner(uid) || admin();
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['uid','email','displayName','photoURL','isAnonymous','lastLoginAt','updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 100;
      match /inventory/{id} { allow read: if owner(uid) || admin(); }
      match /ledger/{id} { allow read: if owner(uid) || admin(); }
      match /operations/{id} { allow read: if owner(uid) || admin(); }
    }
    // All financial, catalog, stock, audit and fulfillment writes go through authenticated functions.
    match /{document=**} { allow read, write: if false; }
  }
}
